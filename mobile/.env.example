# All client-bundled env vars must be prefixed with EXPO_PUBLIC_ — values
# without that prefix are stripped from the JS bundle by Expo.

# Backend
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Google OAuth — match these to backend GOOGLE_CLIENT_ID_*
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Apple Sign In — only the Services ID / Bundle ID is used on the client.
# The signing key stays on the backend.
EXPO_PUBLIC_APPLE_BUNDLE_ID=com.arenadosmantos.app
