{
  "expo": {
    "name": "Arena dos Mantos",
    "slug": "arena-dos-mantos",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "arenadosmantos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arenadosmantos.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.arenadosmantos.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "CAMERA",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.281984451863-p0khpjsuoaa0ltctomlvu5gca0es5rv4"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2a3afaab-ac27-4e04-884f-2664185c0445"
      }
    },
    "owner": "yuri-silva"
  }
}
